# --- App ---
APP_NAME=NexaPilot AI
ENVIRONMENT=development
API_KEY=change-me-dev-key
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nexapilot:nexapilot@db:5432/nexapilot

# --- LLM provider (used by agents/graph/orchestrator.py) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Tools ---
TAVILY_API_KEY=

# --- n8n integration ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=change-me-webhook-secret

# --- Auth0 OIDC Security Configuration ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.nexapilot.ai
