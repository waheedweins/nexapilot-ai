# --- Application Settings ---
ENVIRONMENT=development
APP_NAME="NexaPilot AI"
API_KEY=change-me-dev-key
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database & Infrastructure ---
DATABASE_URL=postgresql+asyncpg://nexapilot:nexapilot@db:5432/nexapilot
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# --- LLM Providers & Search APIs ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
TAVILY_API_KEY=your-tavily-search-api-key-here
APOLLO_API_KEY=your-apollo-io-api-key-here

# --- Webhooks & Integration ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/nexapilot
N8N_WEBHOOK_SECRET=change-me-webhook-secret

# --- Auth0 OIDC Security ---
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.nexapilot.ai

# --- LangSmith Telemetry Settings ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=nexapilot-ai
